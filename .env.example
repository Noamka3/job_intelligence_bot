# Copy this file to .env and fill in real values. Never commit .env.

# --- Database ---
# Port 5544, not 5432: avoids colliding with any native Postgres install or
# other project's Postgres container already using 5432/5433 on this
# machine. Matches docker-compose.yml's postgres port mapping.
DATABASE_URL=postgresql+psycopg://job_bot:job_bot@localhost:5544/job_bot

# --- Redis (Celery broker/backend, used from Phase 6 onward) ---
# Port 6380, not 6379: same reasoning - avoids an existing Redis container
# on this machine. Matches docker-compose.yml's redis port mapping.
REDIS_URL=redis://localhost:6380/0

# --- Google Sheets (company source of truth) ---
# Sheet ID and gid identify the workbook/tab; the tab title is resolved at
# runtime via the Sheets API, never assumed.
GOOGLE_SHEET_ID=
GOOGLE_SHEET_GID=168609393
# Path to a Google service-account JSON key file. Share the target sheet
# with the service account's client_email (Viewer is enough).
GOOGLE_APPLICATION_CREDENTIALS=./secrets/google-service-account.json

# --- Embeddings ---
# "local" (default): free, runs on this machine, no API key needed.
# "openai": higher quality, costs a few cents/month at this project's
# volume, needs OPENAI_API_KEY below. Switching providers means
# re-embedding everything that was already stored.
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSIONS=384
# Only used when EMBEDDING_PROVIDER=openai.
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-large

# --- LLM (structured CV extraction now; optional reranking from Phase 5+) ---
# "ollama" (default): free, runs on this machine - needs `ollama serve`
# running and the model pulled once (`ollama pull llama3.2:3b`).
# "openai": needs OPENAI_API_KEY above.
# CPU-only inference can be very slow on underpowered hardware (observed:
# minutes for a short input on this dev machine) - raise the timeout, pick
# a smaller model, or switch to openai if extraction keeps timing out.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=120
OPENAI_CHAT_MODEL=gpt-5.4-mini

# --- Display / scheduling defaults ---
DEFAULT_TIMEZONE=Asia/Jerusalem
DEFAULT_POLL_MINUTES=5
JOB_MISSING_THRESHOLD=3

# --- Matching / notifications ---
NOTIFICATION_SCORE_THRESHOLD=80

# Match score component weights (must sum to 1.0). Rebalanced toward
# seniority/role vs. spec's suggested 30/20/20/10/10/5/5 starting point -
# verified empirically that raw semantic similarity alone barely
# distinguishes "Junior" from "Senior" for the same role/tech stack, so a
# 10% seniority weight couldn't override it. See docs/matching.md.
WEIGHT_CANDIDATE_SEMANTIC=0.20
WEIGHT_INTENT_SEMANTIC=0.12
WEIGHT_SKILLS=0.20
WEIGHT_ROLE=0.15
WEIGHT_SENIORITY=0.28
WEIGHT_LOCATION=0.03
WEIGHT_RECENCY=0.02

# --- Twilio WhatsApp (Phase 7) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
WHATSAPP_TO=whatsapp:+972500000000
